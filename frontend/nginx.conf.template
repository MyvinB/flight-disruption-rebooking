server {
    listen ${PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Same origin for UI and API, like the Vite dev proxy: no CORS needed in the browser
    location /api/ {
        proxy_pass ${BACKEND_URL};
        # Host stays the backend's own host (nginx default): Render routes requests to a service by Host
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Send the backend's name in the TLS handshake (SNI) when BACKEND_URL is https
        proxy_ssl_server_name on;
        # A sleeping free-tier backend needs up to about a minute to wake up
        proxy_read_timeout 90s;
    }

    # Hashed bundles never change, so they can be cached for long
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
    }
}
